# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/ideal-bathware

# NextAuth v5 — uses AUTH_SECRET / AUTH_URL (renamed in v5)
AUTH_SECRET=your-secret-here
AUTH_URL=http://localhost:3000

# Admin credentials
ADMIN_EMAIL=admin@idealbathware.com
# Generate hash then base64-encode to avoid $ interpolation issues:
# node -e "const b=require('bcryptjs'),h=b.hashSync('pass',12);console.log(Buffer.from(h).toString('base64'))"
ADMIN_PASSWORD_HASH_B64=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On-demand revalidation
REVALIDATION_SECRET=your-revalidation-secret

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
